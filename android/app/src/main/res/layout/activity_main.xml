<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/link_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp" >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Link to Linux"
        android:textColor="@color/link_text"
        android:textSize="30sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Your phone. Your desktop. Connected."
        android:textColor="@color/link_muted"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/status_background"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="Starting link service…"
        android:textColor="@color/link_text"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:accessibilityLiveRegion="polite" />
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/pageTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/devicesTab" >
        <com.google.android.material.button.MaterialButton
            android:id="@+id/devicesTab"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Devices" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sharingTab"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Sharing" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <ScrollView
        android:id="@+id/pageScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingTop="10dp"
        android:paddingBottom="12dp" >
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/devicesPage" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Link.SectionTitle" android:text="Your devices" />
                <LinearLayout
                    android:id="@+id/devicesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <TextView style="@style/Link.SectionTitle" android:text="Connect another device" />
                <com.google.android.material.card.MaterialCardView style="@style/Link.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <EditText
                            android:id="@+id/peerAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints=""
                            android:hint="192.168.1.20:53536"
                            android:inputType="textUri"
                            android:singleLine="true"
                            android:textColor="@color/link_text"
                            android:textColorHint="@color/link_muted"
                            android:minHeight="52dp"
                            android:contentDescription="Desktop network address and port" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/connectBtn"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Connect to address" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/startServiceBtn"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Link service" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/pingHostBtn"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ping emulator host" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scanLanBtn"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scan local network" />
                        <TextView
                            android:id="@+id/discoveryStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="4dp"
                            android:text="Nearby devices appear here."
                            android:textColor="@color/link_muted"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/Link.Card">
                    <TextView
                        android:id="@+id/identityText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/link_muted"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/sharingPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" >
                <TextView style="@style/Link.SectionTitle" android:text="Clipboard" />
                <com.google.android.material.card.MaterialCardView style="@style/Link.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Copy on one device, paste on the other. To send while Link is minimized, use Send clipboard in the running notification."
                            android:textColor="@color/link_muted"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/clipboardSyncBtn"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Clipboard: off" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sendClipboardBtn"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Send current" />
                        </LinearLayout>
                        <TextView style="@style/Link.SectionTitle" android:text="Photos" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Browse the photos you allow from your desktop."
                            android:textColor="@color/link_muted"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/galleryAccessBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Allow gallery access" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView style="@style/Link.SectionTitle" android:text="Messages" />
                <com.google.android.material.card.MaterialCardView style="@style/Link.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Read and reply to SMS and MMS from your desktop. Contact access adds names and recipient search. RCS is unavailable. Carrier charges may apply."
                            android:textColor="@color/link_muted"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/messagesAccessBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enable message sharing" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/contactsAccessBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Allow contact access" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView style="@style/Link.SectionTitle" android:text="Notifications" />
                <com.google.android.material.card.MaterialCardView style="@style/Link.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="See phone alerts on your desktop. Grant access, then choose which apps to share. Ongoing notifications stay on your phone."
                            android:textColor="@color/link_muted"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/notificationForwardBtn"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Forwarding: off" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/notificationAccessBtn"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Grant access" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/notificationAppsBtn"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Choose apps to forward" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
