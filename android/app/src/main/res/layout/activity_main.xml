<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/link_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Link to Linux"
        android:textColor="@color/link_text"
        android:textSize="28sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Pair devices and share across your local network."
        android:textColor="@color/link_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/status_background"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="Starting link service…"
        android:textColor="@color/link_text"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Link.Card">
                <TextView
                    android:id="@+id/identityText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/link_muted"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/Link.SectionTitle" android:text="Pair a device" />
            <com.google.android.material.card.MaterialCardView style="@style/Link.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <EditText
                        android:id="@+id/peerAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints=""
                        android:hint="192.168.1.20:53536"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textColor="@color/link_text"
                        android:textColorHint="@color/link_muted" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/connectBtn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Connect to address" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/startServiceBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Link service" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pingHostBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ping emulator host" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scanLanBtn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan local network" />
                    <TextView
                        android:id="@+id/discoveryStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="4dp"
                        android:text="Nearby devices appear here."
                        android:textColor="@color/link_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/Link.SectionTitle" android:text="Clipboard" />
            <com.google.android.material.card.MaterialCardView style="@style/Link.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Incoming clips sync in the background. Android blocks Link from reading copied content while minimized. Tap Send clipboard in the running notification to open Link and send the latest clip. Grant gallery access so paired Linux devices can browse photos stored on this phone."
                        android:textColor="@color/link_muted"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/clipboardSyncBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Clipboard: off" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sendClipboardBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Send current" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/galleryAccessBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Allow gallery access" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/Link.SectionTitle" android:text="Messages (SMS/MMS)" />
            <com.google.android.material.card.MaterialCardView style="@style/Link.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Read SMS/MMS history and send individual texts or group MMS from Linux. Allow Contacts to choose people by name. RCS chats are not available. Carrier charges may apply."
                        android:textColor="@color/link_muted"
                        android:textSize="13sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/messagesAccessBtn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enable message sharing" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/contactsAccessBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Allow contact access" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/Link.SectionTitle" android:text="Phone notifications" />
            <com.google.android.material.card.MaterialCardView style="@style/Link.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Forward selected Android app alerts to paired Linux devices. Ongoing notifications are always skipped. Android requires notification access."
                        android:textColor="@color/link_muted"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/notificationForwardBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Forwarding: off" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/notificationAccessBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Grant access" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/notificationAppsBtn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose apps to forward" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/Link.SectionTitle" android:text="Trusted and nearby devices" />
            <LinearLayout
                android:id="@+id/devicesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
